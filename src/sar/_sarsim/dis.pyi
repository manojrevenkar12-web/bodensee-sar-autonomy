"""DIS v7 Entity State PDU"""

from collections.abc import Sequence


class EntityType:
    def __init__(self) -> None: ...

    @property
    def kind(self) -> int: ...

    @kind.setter
    def kind(self, arg: int, /) -> None: ...

    @property
    def domain(self) -> int: ...

    @domain.setter
    def domain(self, arg: int, /) -> None: ...

    @property
    def country(self) -> int: ...

    @country.setter
    def country(self, arg: int, /) -> None: ...

    @property
    def category(self) -> int: ...

    @category.setter
    def category(self, arg: int, /) -> None: ...

    @property
    def subcategory(self) -> int: ...

    @subcategory.setter
    def subcategory(self, arg: int, /) -> None: ...

    @property
    def specific(self) -> int: ...

    @specific.setter
    def specific(self, arg: int, /) -> None: ...

    @property
    def extra(self) -> int: ...

    @extra.setter
    def extra(self, arg: int, /) -> None: ...

class EntityState:
    def __init__(self) -> None: ...

    @property
    def exercise(self) -> int: ...

    @exercise.setter
    def exercise(self, arg: int, /) -> None: ...

    @property
    def timestamp(self) -> int: ...

    @timestamp.setter
    def timestamp(self, arg: int, /) -> None: ...

    @property
    def site(self) -> int: ...

    @site.setter
    def site(self, arg: int, /) -> None: ...

    @property
    def application(self) -> int: ...

    @application.setter
    def application(self, arg: int, /) -> None: ...

    @property
    def entity(self) -> int: ...

    @entity.setter
    def entity(self, arg: int, /) -> None: ...

    @property
    def force(self) -> int: ...

    @force.setter
    def force(self, arg: int, /) -> None: ...

    @property
    def type(self) -> EntityType: ...

    @type.setter
    def type(self, arg: EntityType, /) -> None: ...

    @property
    def velocity(self) -> list[float]: ...

    @velocity.setter
    def velocity(self, arg: Sequence[float], /) -> None: ...

    @property
    def location(self) -> list[float]: ...

    @location.setter
    def location(self, arg: Sequence[float], /) -> None: ...

    @property
    def orientation(self) -> list[float]: ...

    @orientation.setter
    def orientation(self, arg: Sequence[float], /) -> None: ...

    @property
    def appearance(self) -> int: ...

    @appearance.setter
    def appearance(self, arg: int, /) -> None: ...

    @property
    def dead_reckoning(self) -> int: ...

    @dead_reckoning.setter
    def dead_reckoning(self, arg: int, /) -> None: ...

    @property
    def marking(self) -> str: ...

    @marking.setter
    def marking(self, arg: str, /) -> None: ...

    @property
    def capabilities(self) -> int: ...

    @capabilities.setter
    def capabilities(self, arg: int, /) -> None: ...

class Kinematics:
    def __init__(self) -> None: ...

    @property
    def lat(self) -> float: ...

    @lat.setter
    def lat(self, arg: float, /) -> None: ...

    @property
    def lon(self) -> float: ...

    @lon.setter
    def lon(self, arg: float, /) -> None: ...

    @property
    def alt(self) -> float: ...

    @alt.setter
    def alt(self, arg: float, /) -> None: ...

    @property
    def heading_deg(self) -> float: ...

    @heading_deg.setter
    def heading_deg(self, arg: float, /) -> None: ...

    @property
    def speed(self) -> float: ...

    @speed.setter
    def speed(self, arg: float, /) -> None: ...

def encode(arg: EntityState, /) -> bytes: ...

def decode(arg: bytes, /) -> EntityState: ...

def set_kinematics(arg0: EntityState, arg1: Kinematics, /) -> None: ...

def get_kinematics(arg: EntityState, /) -> Kinematics: ...

def geodetic_to_ecef(arg0: float, arg1: float, arg2: float, /) -> list[float]: ...

def ecef_to_geodetic(arg0: float, arg1: float, arg2: float, /) -> list[float]: ...
