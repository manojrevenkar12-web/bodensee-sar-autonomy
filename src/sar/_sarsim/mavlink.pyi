from typing import overload


def crc_x25(arg: bytes, /) -> int: ...

def encode(msgid: int, payload: bytes, seq: int = 0, sysid: int = 255, compid: int = 190) -> bytes: ...

class Parser:
    def __init__(self) -> None: ...

    def feed(self, arg: bytes, /) -> list: ...

    @property
    def crc_errors(self) -> int: ...

    @property
    def unknown(self) -> int: ...

